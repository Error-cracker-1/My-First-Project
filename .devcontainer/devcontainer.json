{
  "name": "My First Project",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installGradle": true
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Flask App",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "git config --global init.defaultBranch main && git config --global pull.rebase false && git config --global core.autocrlf input && python -m pip install --upgrade pip && pip install -r requirements.txt && npm install --no-audit --no-fund",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "PORT": "3000"
  },
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
  ],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "dracula-theme.theme-dracula",
        "eamodio.gitlens",
        "elanandkumar.el-vsc-product-icon-theme",
        "esbenp.prettier-vscode",
        "github.codespaces",
        "github.github-vscode-theme",
        "github.remotehub",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "vscjava.vscode-gradle",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.jupyter-slideshow",
        "ms-vscode.azure-repos",
        "ms-vscode.powershell",
        "ms-vscode.remote-repositories",
        "openai.chatgpt",
        "vscode-icons-team.vscode-icons"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.rulers": [100],
        "files.trimTrailingWhitespace": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": true,
        "git.enableSmartCommit": true,
        "git.autofetch": true,
        "github.copilot.enable": {
          "*": true,
          "python": true,
          "javascript": true
        }
      }
    }
  }
}
